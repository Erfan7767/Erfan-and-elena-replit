{
  "expo": {
    "name": "Irfan & Elena Voice AI",
    "slug": "irfan-elena-voice-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "irfan-elena-voice-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": ["RECORD_AUDIO", "INTERNET"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router", "expo-speech-recognition"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
